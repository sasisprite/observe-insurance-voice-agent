# Browser-safe Vapi configuration
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_PUBLIC_SERVER_URL=http://localhost:3005

# Server-side Vapi provisioning; never expose in browser builds
VAPI_PRIVATE_KEY=
PUBLIC_SERVER_URL=https://your-public-host.example.com

# Runtime and persistence
APP_ENV=development
VOICE_REPOSITORY=json
DATABASE_URL=
TENANT_DEPLOYMENT_KEY=observe-insurance-dev

# Admin control plane; replace all demo values before production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional integrations
OAUTH_SERVER_URL=
OPENROUTER_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
